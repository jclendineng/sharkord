{
  "name": "@sharkord/server",
  "version": "0.0.27",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch ./src/index.ts",
    "dev:inspect": "bun --inspect ./src/index.ts",
    "dev:debug": "DEBUG=* bun --watch ./src/index.ts",
    "build": "tsc -b && bun ./build/build.ts",
    "db:gen": "bunx drizzle-kit generate --dialect sqlite --schema ./src/db/schema.ts --out ./src/db/migrations",
    "db:check": "bunx drizzle-kit check --dialect sqlite --out ./src/db/migrations",
    "seed:mock": "bun ./scripts/seed-mock.ts",
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --config ./.prettierrc.json",
    "lint": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives",
    "lint:fix": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/ini": "^4.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/sanitize-html": "^2.16.2",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jose": "^6.2.13",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@sharkord/plugin-sdk": "workspace:*",
    "@sharkord/shared": "workspace:*",
    "@trpc/server": "^11.19.0",
    "bun-sfe-autoupdater": "^0.0.4",
    "chalk": "^5.6.2",
    "cron": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "image-size": "^2.0.4",
    "ini": "^5.0.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "link-preview-js": "^5.0.1",
    "mediasoup": "3.31.0",
    "openid-client": "^6.8.8",
    "queue": "^7.0.0",
    "sanitize-html": "^2.18.1",
    "semver": "^7.8.5",
    "string-argv": "^0.3.2",
    "systeminformation": "^5.33.16",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  }
}