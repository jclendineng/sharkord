{
  "name": "@sharkord/push-relay",
  "version": "0.0.27",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "bunx wrangler@4.152.0 dev",
    "deploy": "bunx wrangler@4.152.0 deploy",
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --config ./.prettierrc.json",
    "lint": "eslint ./src --report-unused-disable-directives",
    "lint:fix": "eslint ./src --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.0"
  },
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
