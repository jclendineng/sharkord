    "That code doesn't hold a server address.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kód neobsahuje adresu serveru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no contiene una dirección de servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code ne contient pas d’adresse de serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice non contiene l’indirizzo di un server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código não tem um endereço de servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом коде нет адреса сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该代码不包含服务器地址。"
          }
        }
      }
    },
    "That code is for another server. Scan it from that server's settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kód je pro jiný server. Naskenujte ho z nastavení toho serveru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código es de otro servidor. Escanéalo desde los ajustes de ese servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code est pour un autre serveur. Scannez-le depuis les réglages de ce serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice è per un altro server. Scansionalo dalle impostazioni di quel server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código é de outro servidor. Escaneie nas configurações desse servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код для другого сервера. Отсканируйте его из настроек того сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该代码属于另一台服务器。请从那台服务器的设置中扫描。"
          }
        }
      }
    },
    "That doesn't look like a server address.": {
      "localizations": {
