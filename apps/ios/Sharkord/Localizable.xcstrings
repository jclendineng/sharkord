    "Leave it empty to show the people in it instead.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte prázdné, aby se zobrazili lidé ve skupině."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para mostrar a las personas que hay en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour afficher les personnes qui en font partie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascialo vuoto per mostrare le persone che ne fanno parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe vazio para mostrar as pessoas que estão nele."
          }
        },
        "ru": {
