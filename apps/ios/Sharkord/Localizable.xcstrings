    "Show a new code on the other device and scan it again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazte na druhém zařízení nový kód a naskenujte ho znovu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un código nuevo en el otro dispositivo y escanéalo otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez un nouveau code sur l’autre appareil et scannez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un nuovo codice sull’altro dispositivo e scansionalo di nuovo."
          }
        },
        "pt-BR": {
