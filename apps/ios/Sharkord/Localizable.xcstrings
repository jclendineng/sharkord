    "Replies to you count as mentions. Direct messages notify for every message unless set to nothing.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovědi vám se počítají jako zmínky. Soukromé zprávy upozorňují na každou zprávu, pokud nezvolíte nic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas a ti cuentan como menciones. Los mensajes directos avisan de cada mensaje salvo que elijas nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses qui vous sont adressées comptent comme des mentions. Les messages privés notifient chaque message sauf si vous choisissez rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte a te contano come menzioni. I messaggi diretti avvisano per ogni messaggio a meno che non scegli niente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respostas a você contam como menções. Mensagens diretas notificam toda mensagem, a menos que você escolha nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы вам считаются упоминаниями. Личные сообщения уведомляют о каждом сообщении, если не выбрано «Ничего»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对你的回复算作提及。私信会对每条消息发出通知，除非设为“无”。"
          }
        }
      }
    },
