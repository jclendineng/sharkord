    "Noise Suppression applies the next time you join a voice channel.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potlačení šumu se projeví při příštím vstupu do hlasového kanálu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La supresión de ruido se aplica la próxima vez que entres en un canal de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réduction de bruit s’applique la prochaine fois que vous rejoignez un salon vocal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La soppressione del rumore si applica la prossima volta che entri in un canale vocale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A supressão de ruído vale na próxima vez que você entrar em um canal de voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шумоподавление начнёт работать при следующем входе в голосовой канал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降噪将在你下次加入语音频道时生效。"
          }
        }
      }
    },
    "Noise suppression, echo cancellation and gain control apply the next time you join a voice channel.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potlačení šumu, ozvěny a řízení zisku se projeví při příštím vstupu do hlasového kanálu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La supresión de ruido, la cancelación de eco y el control de ganancia se aplican la próxima vez que entres en un canal de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réduction de bruit, l’annulation d’écho et le contrôle du gain s’appliquent la prochaine fois que vous rejoignez un salon vocal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soppressione del rumore, cancellazione dell’eco e controllo del guadagno si applicano la prossima volta che entri in un canale vocale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Supressão de ruído, cancelamento de eco e controle de ganho valem na próxima vez que você entrar em um canal de voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шумоподавление, эхоподавление и регулировка усиления начнут работать при следующем входе в голосовой канал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降噪、回声消除和增益控制将在你下次加入语音频道时生效。"
          }
        }
      }
    },
