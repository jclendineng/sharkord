        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空则显示群组中的人。"
          }
        }
      }
    },
    "Leave the voice channel to preview your camera.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opusťte hlasový kanál, abyste mohli zobrazit náhled kamery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal del canal de voz para previsualizar tu cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez le salon vocal pour prévisualiser votre caméra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci dal canale vocale per l’anteprima della fotocamera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saia do canal de voz para ver a prévia da câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйдите из голосового канала, чтобы проверить камеру."
