    "GIFs aren't set up on this server. An admin can add a Klipy API key in Server Settings, under Overview.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFy nejsou na tomto serveru nastavené. Administrátor může přidat klíč API Klipy v Nastavení serveru, v části Přehled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los GIF no están configurados en este servidor. Un administrador puede añadir una clave de API de Klipy en Ajustes del servidor, en Resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les GIF ne sont pas configurés sur ce serveur. Un administrateur peut ajouter une clé d’API Klipy dans les Réglages du serveur, sous Aperçu."
