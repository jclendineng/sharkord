    "Sounds, banners and alerts are set in System Settings, under Notifications.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuky, bannery a upozornění se nastavují v Nastavení systému v části Oznámení."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos, banners y alertas se configuran en Ajustes del Sistema, en Notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons, bannières et alertes se règlent dans Réglages Système, sous Notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suoni, banner e avvisi si impostano in Impostazioni di Sistema, in Notifiche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sons, banners e alertas são definidos em Ajustes do Sistema, em Notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звуки, баннеры и оповещения настраиваются в Системных настройках, в разделе «Уведомления»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音、横幅和提醒在“系统设置”的“通知”中设置。"
          }
        }
      }
    },
    "Sounds, banners and the lock screen are set in Settings.": {
