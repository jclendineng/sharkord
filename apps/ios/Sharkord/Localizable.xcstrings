    "Talk and watch the meter move. Use headphones to hear yourself without feedback.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluvte a sledujte, jak se ukazatel hýbe. Použijte sluchátka, abyste se slyšeli bez zpětné vazby."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla y mira cómo se mueve el medidor. Usa auriculares para oírte sin acoples."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez et regardez le niveau bouger. Utilisez un casque pour vous entendre sans effet Larsen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla e guarda muoversi l’indicatore. Usa le cuffie per sentirti senza ritorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale e veja o medidor se mexer. Use fones para se ouvir sem microfonia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите и следите за индикатором. Используйте наушники, чтобы слышать себя без эха."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话并观察电平表变化。戴上耳机即可听到自己而不会啸叫。"
          }
        }
      }
    },
    "Talk once they've joined.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluvit, jakmile se připojí."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hablar una vez que se hayan unido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parler une fois qu’ils ont rejoint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlare una volta entrati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falar depois de entrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорить после входа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入后可发言。"
          }
        }
      }
    },
    "Tap an invite to see who joined with it, swipe to delete it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na pozvánku a uvidíte, kdo se s ní připojil, přejetím ji smažete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una invitación para ver quién se unió con ella, desliza para eliminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une invitation pour voir qui l’a utilisée, balayez pour la supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un invito per vedere chi è entrato con esso, scorri per eliminarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um convite para ver quem entrou com ele, deslize para excluí-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на приглашение, чтобы увидеть, кто по нему вошёл, смахните, чтобы удалить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点邀请可查看通过它加入的人，轻扫可删除。"
          }
        }
      }
    },
    "Tap to add a note": {
      "localizations": {
