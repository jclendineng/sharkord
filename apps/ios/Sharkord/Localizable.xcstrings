    "Running Sharkord in Docker keeps the damage contained. Only install plugins you trust.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Provoz Sharkordu v Dockeru omezí případné škody. Instalujte jen pluginy, kterým důvěřujete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutar Sharkord en Docker limita los daños. Instala solo plugins de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire tourner Sharkord dans Docker limite les dégâts. N’installez que des plugins de confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguire Sharkord in Docker limita i danni. Installa solo plugin di cui ti fidi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodar o Sharkord no Docker limita os danos. Só instale plugins em que você confia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск Sharkord в Docker ограничивает возможный ущерб. Устанавливайте только плагины, которым доверяете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Docker 中运行 Sharkord 可以限制损害范围。只安装你信任的插件。"
          }
        }
      }
    },
