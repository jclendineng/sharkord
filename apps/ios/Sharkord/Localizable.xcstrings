            "state": "translated",
            "value": "Oznámení"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificaciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifiche"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificações"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        }
      }
    },
    "Notifications pass through Apple. Off, they only say who sent something, never what or in which channel.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení procházejí přes Apple. Vypnuté říkají jen, kdo něco poslal, nikdy co ani v jakém kanálu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones pasan por Apple. Desactivado, solo dicen quién envió algo, nunca qué ni en qué canal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications passent par Apple. Désactivé, elles indiquent seulement qui a envoyé quelque chose, jamais quoi ni dans quel salon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche passano da Apple. Se disattivato dicono solo chi ha inviato qualcosa, mai cosa né in quale canale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações passam pela Apple. Desativado, elas só dizem quem enviou algo, nunca o quê nem em qual canal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления проходят через Apple. Если выключено, в них только видно, кто что-то отправил, но не что и не в каком канале."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知会经过 Apple。关闭后，通知只显示谁发了内容，不会显示内容或所在频道。"
          }
        }
      }
    },
    "Notifications reach devices through the app's relay, which only sees them encrypted. Off, this server sends no push notifications. The same switch is relayEnabled under [push] in config.ini.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení se k zařízením dostávají přes relay aplikace, který je vidí jen zašifrovaná. Vypnuté znamená, že server neposílá žádná push oznámení. Totéž nastavení je relayEnabled v [push] v config.ini."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones llegan a los dispositivos a través del relé de la app, que solo las ve cifradas. Desactivado, este servidor no envía notificaciones push. Es el mismo ajuste que relayEnabled en [push] de config.ini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications arrivent aux appareils via le relais de l’app, qui ne les voit que chiffrées. Désactivé, ce serveur n’envoie aucune notification push. C’est le même réglage que relayEnabled sous [push] dans config.ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche arrivano ai dispositivi tramite il relay dell’app, che le vede solo cifrate. Se disattivato, questo server non invia notifiche push. È la stessa opzione di relayEnabled in [push] di config.ini."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações chegam aos dispositivos pelo relay do app, que só as vê criptografadas. Desativado, este servidor não envia notificações push. É a mesma opção que relayEnabled em [push] no config.ini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления доходят до устройств через ретранслятор приложения, который видит их только в зашифрованном виде. Если выключено, сервер не отправляет push-уведомления. Это тот же параметр, что relayEnabled в [push] в config.ini."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知通过应用的中继发送到设备，中继只能看到加密后的内容。关闭后，此服务器不发送推送通知。与 config.ini 中 [push] 下的 relayEnabled 是同一开关。"
          }
        }
      }
    },
