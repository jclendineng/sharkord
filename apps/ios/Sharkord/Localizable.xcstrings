    "%@ only takes new members with an invite. Paste the link you were sent above, or log in if you already have an account.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ přijímá nové členy jen s pozvánkou. Vložte výše odkaz, který jste dostali, nebo se přihlaste, pokud už účet máte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo admite nuevos miembros con invitación. Pega arriba el enlace que te enviaron o inicia sesión si ya tienes una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’accepte les nouveaux membres que sur invitation. Collez ci-dessus le lien reçu, ou connectez-vous si vous avez déjà un compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accetta nuovi membri solo con un invito. Incolla sopra il link che hai ricevuto, oppure accedi se hai già un account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ só aceita novos membros com convite. Cole acima o link que você recebeu ou entre se já tiver uma conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ принимает новых участников только по приглашению. Вставьте выше полученную ссылку или войдите, если у вас уже есть аккаунт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仅接受持邀请的新成员。请在上方粘贴你收到的链接，如果已有账户，请直接登录。"
          }
        }
      }
    },
