    "System follows this device's light or dark setting. Calls and sign in stay dark either way.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systém se řídí světlým nebo tmavým nastavením tohoto zařízení. Hovory a přihlášení zůstávají tmavé v každém případě."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema sigue el ajuste claro u oscuro de este dispositivo. Las llamadas y el inicio de sesión siguen oscuros en cualquier caso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système suit le réglage clair ou sombre de cet appareil. Les appels et la connexion restent sombres dans tous les cas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue l’impostazione chiara o scura di questo dispositivo. Le chiamate e l’accesso restano scuri in ogni caso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue o ajuste claro ou escuro deste dispositivo. Chamadas e a entrada continuam escuras de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Системное» следует светлой или тёмной теме устройства. Звонки и вход в любом случае остаются тёмными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“系统”跟随此设备的浅色或深色设置。通话和登录界面始终为深色。"
          }
        }
      }
    },
    "Take Away %@ Once They React": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat %@ po reakci"
          }
