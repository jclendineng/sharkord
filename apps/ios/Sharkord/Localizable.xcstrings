    "Start the mic test or join a voice channel, then pick it under Mic Mode here or in Control Center.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spusťte test mikrofonu nebo vstupte do hlasového kanálu a pak ho vyberte v Režimu mikrofonu tady nebo v Ovládacím centru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la prueba de micro o entra en un canal de voz y elígelo en Modo de micrófono aquí o en el Centro de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez le test du micro ou rejoignez un salon vocal, puis choisissez-le sous Mode micro ici ou dans le Centre de contrôle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la prova microfono o entra in un canale vocale, poi sceglilo in Modalità microfono qui o in Centro di Controllo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o teste de microfone ou entre em um canal de voz, depois escolha em Modo de microfone aqui ou na Central de Controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите проверку микрофона или войдите в голосовой канал, затем выберите его в «Режиме микрофона» здесь или в Пункте управления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始麦克风测试或加入语音频道，然后在这里或控制中心的“麦克风模式”中选择它。"
          }
        }
      }
