    "Only Ask the First Time": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ptát se jen poprvé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar solo la primera vez"
          }
        },
