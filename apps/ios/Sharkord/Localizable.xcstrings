    "MB": {},
    "MP3, WAV or M4A, 512 KB at most. Anyone in a call can play them for everyone there.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3, WAV nebo M4A, nejvýše 512 KB. Kdokoli v hovoru je může přehrát všem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3, WAV o M4A, 512 KB como máximo. Cualquiera en una llamada puede reproducirlos para todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3, WAV ou M4A, 512 Ko maximum. Toute personne dans un appel peut les jouer pour tous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3, WAV o M4A, al massimo 512 KB. Chiunque in una chiamata può riprodurli per tutti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3, WAV ou M4A, no máximo 512 KB. Qualquer pessoa em uma chamada pode tocá-los para todos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3, WAV или M4A, не больше 512 КБ. Любой в звонке может воспроизвести их для всех."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3、WAV 或 M4A，最大 512 KB。通话中的任何人都可以为所有人播放。"
          }
        }
      }
    },
