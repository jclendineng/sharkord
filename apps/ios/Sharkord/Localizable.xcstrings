    "Members silent in a call for the timeout are moved to the AFK channel.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Členové, kteří jsou v hovoru zticha déle než limit, se přesunou do kanálu nepřítomných."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros en silencio en una llamada durante el tiempo indicado pasan al canal de ausentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres silencieux dans un appel pendant le délai sont déplacés vers le salon d’absence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I membri in silenzio in una chiamata per il tempo indicato vengono spostati nel canale assenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Membros em silêncio numa chamada pelo tempo definido vão para o canal de ausentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Участники, молчащие в звонке дольше тайм-аута, переносятся в канал для отошедших."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在通话中静默超过超时时间的成员会被移到挂机频道。"
          }
        }
      }
    },
