    "Enter a valid server address.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte platnou adresu serveru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una dirección de servidor válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une adresse de serveur valide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un indirizzo del server valido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um endereço de servidor válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите правильный адрес сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的服务器地址。"
          }
        }
      }
    },
    "Every file link carries a token that expires, handed only to people who can see the file, so nobody can guess their way to one. The apps fetch fresh links on their own.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý odkaz na soubor nese token s omezenou platností, který dostane jen ten, kdo soubor smí vidět, takže ho nikdo neuhodne. Aplikace si nové odkazy získávají samy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada enlace a un archivo lleva un token que caduca y solo se da a quien puede ver el archivo, así nadie puede adivinar uno. Las apps obtienen enlaces nuevos por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque lien de fichier porte un jeton qui expire, remis seulement à ceux qui peuvent voir le fichier, personne ne peut donc en deviner un. Les apps récupèrent d’elles-mêmes de nouveaux liens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni link a un file porta un token che scade, dato solo a chi può vedere il file, così nessuno può indovinarne uno. Le app ottengono da sole link nuovi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada link de arquivo leva um token que expira, entregue só a quem pode ver o arquivo, então ninguém consegue adivinhar um. Os apps buscam links novos sozinhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая ссылка на файл содержит истекающий токен, который выдаётся только тем, кто может видеть файл, поэтому её нельзя угадать. Приложения сами получают новые ссылки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个文件链接都带有会过期的令牌，只发给能查看该文件的人，因此无人能猜出链接。应用会自行获取新链接。"
          }
        }
      }
    },
    "Every other device will have to log in again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na všech ostatních zařízeních se bude nutné znovu přihlásit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los demás dispositivos tendrán que volver a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les autres appareils devront se reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli altri dispositivi dovranno accedere di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os outros dispositivos vão precisar entrar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На всех остальных устройствах придётся войти снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他所有设备都需要重新登录。"
          }
        }
      }
    },
    "Everyone": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všichni"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos"
          }
        },
        "fr": {
