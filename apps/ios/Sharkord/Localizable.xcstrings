    "Otherwise their messages stay, shown as from a deleted user. This can't be undone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jinak jejich zprávy zůstanou, jako od smazaného uživatele. Tuto akci nelze vrátit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, sus mensajes se quedan, como de un usuario eliminado. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon leurs messages restent, affichés comme d’un utilisateur supprimé. Action irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti i loro messaggi restano, come di un utente eliminato. Non si può annullare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, as mensagens ficam, como de um usuário excluído. Não dá para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Иначе их сообщения останутся как от удалённого пользователя. Это нельзя отменить."
