    "Only Some Roles": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen některé role"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo algunos roles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement certains rôles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo alcuni ruoli"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só alguns cargos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только некоторые роли"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅部分身份组"
          }
        }
      }
    },
    "Only sounds free to reuse are shown. A sound that asks for credit keeps it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazují se jen zvuky volně k použití. Zvuk, který vyžaduje uvedení autora, si ho ponechá."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran sonidos libres para reutilizar. Un sonido que pide atribución la conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les sons libres de réutilisation sont affichés. Un son qui demande un crédit le conserve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono mostrati solo suoni liberi da riutilizzare. Un suono che chiede l’attribuzione la mantiene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só aparecem sons livres para reutilizar. Um som que pede crédito o mantém."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны только звуки, свободные для повторного использования. Звук, требующий указания автора, его сохраняет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只显示可自由再利用的音效。要求署名的音效会保留署名。"
          }
        }
      }
    },
    "Only the roles and members given access in Permissions can see a private channel.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soukromý kanál vidí jen role a členové s přístupem v části Oprávnění."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los roles y miembros con acceso en Permisos pueden ver un canal privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les rôles et membres ayant accès dans Permissions peuvent voir un salon privé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i ruoli e i membri con accesso in Permessi possono vedere un canale privato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os cargos e membros com acesso em Permissões podem ver um canal privado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытый канал видят только роли и участники с доступом в разделе «Права»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在“权限”中获得访问权的身份组和成员才能看到私密频道。"
          }
        }
      }
    },
