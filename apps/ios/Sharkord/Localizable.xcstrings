    "Right click a message and choose Open Thread to start one.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte pravým tlačítkem na zprávu a zvolte Otevřít vlákno, abyste nějaké začali."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
