    },
    "This server requires a password to join.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento server vyžaduje pro připojení heslo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor pide una contraseña para unirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur exige un mot de passe pour rejoindre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server richiede una password per entrare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor exige uma senha para entrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для входа на этот сервер нужен пароль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入此服务器需要密码。"
          }
        }
      }
    },
    "This server's admins haven't added an address for reports yet. They can add one in Server Settings, under Overview.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrátoři tohoto serveru zatím nepřidali adresu pro nahlášení. Mohou ji přidat v Nastavení serveru, v části Přehled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los administradores de este servidor aún no han añadido una dirección para informes. Pueden añadirla en Ajustes del servidor, en Resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les administrateurs de ce serveur n’ont pas encore ajouté d’adresse de signalement. Ils peuvent l’ajouter dans les Réglages du serveur, sous Aperçu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli amministratori di questo server non hanno ancora aggiunto un indirizzo per le segnalazioni. Possono aggiungerlo nelle Impostazioni del server, in Panoramica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os administradores deste servidor ainda não adicionaram um endereço para denúncias. Eles podem adicionar nas Configurações do servidor, em Visão geral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Администраторы этого сервера ещё не добавили адрес для жалоб. Его можно добавить в настройках сервера, в разделе «Обзор»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器的管理员尚未添加举报地址。可在服务器设置的“概览”中添加。"
          }
        }
      }
    },
