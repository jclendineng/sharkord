          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur un message et choisissez Ouvrir un fil pour en lancer un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic destro su un messaggio e scegli Apri thread per avviarne uno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em uma mensagem e escolha Abrir conversa para começar uma."
