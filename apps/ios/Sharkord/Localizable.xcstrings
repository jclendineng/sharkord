    "Tap to play for everyone, hold to preview": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím přehrajete všem, podržením si poslechnete"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para reproducir para todos, mantén pulsado para escuchar antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour jouer pour tout le monde, maintenez pour pré-écouter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per riprodurre per tutti, tieni premuto per un’anteprima"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para tocar para todos, segure para ouvir antes"
