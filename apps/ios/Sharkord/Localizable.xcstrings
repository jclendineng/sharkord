          }
        }
      }
    },
    "You won't see it again unless someone adds you back.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už ji neuvidíte, dokud vás někdo znovu nepřidá."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No lo volverás a ver salvo que alguien te añada de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne le verrez plus à moins que quelqu’un vous ajoute à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non lo vedrai più a meno che qualcuno non ti aggiunga di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não vai ver de novo a menos que alguém te adicione outra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы больше не увидите её, пока вас снова не добавят."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非有人再次添加你，否则你将不会再看到它。"
          }
        }
      }
    },
    "You'll appear offline, but still have full access": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budete se zobrazovat offline, ale s plným přístupem"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecerás desconectado, pero con acceso completo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous apparaîtrez hors ligne, mais avec un accès complet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparirai offline, ma con accesso completo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai aparecer offline, mas com acesso total"
          }
        },
        "ru": {
          "stringUnit": {
