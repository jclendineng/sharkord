    "Without View Channel nothing else applies, the channel stays hidden.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez oprávnění Vidět kanál neplatí nic dalšího, kanál zůstane skrytý."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Ver canal no se aplica nada más, el canal queda oculto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans Voir le salon, rien d’autre ne s’applique, le salon reste caché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza Vedi canale non si applica nient’altro, il canale resta nascosto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem Ver canal nada mais vale, o canal fica oculto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без права «Видеть канал» остальное не действует, канал остаётся скрытым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有“查看频道”权限，其他权限均不生效，频道保持隐藏。"
          }
        }
      }
    },
    "Without it, members who joined before the rules lose the channels you close.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez toho členové, kteří se připojili před pravidly, přijdou o kanály, které uzavřete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin esto, los miembros que se unieron antes de las normas pierden los canales que cierres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans cela, les membres arrivés avant les règles perdent les salons que vous fermez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza questo, i membri entrati prima delle regole perdono i canali che chiudi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem isso, membros que entraram antes das regras perdem os canais que você fechar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без этого участники, вошедшие до правил, потеряют каналы, которые вы закрываете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则，在规则设立前加入的成员会失去你关闭的频道。"
          }
        }
      }
    },
    "Yes": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是"
          }
        }
      }
    },
    "You do not have permission to send messages in this channel.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemáte oprávnění posílat zprávy v tomto kanálu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para enviar mensajes en este canal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas la permission d’envoyer des messages dans ce salon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai il permesso di inviare messaggi in questo canale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não tem permissão para enviar mensagens neste canal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас нет прав на отправку сообщений в этом канале."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有在此频道发送消息的权限。"
          }
        }
      }
    },
    "You don't have an invite link yet. Choose how long it lasts and how many times it can be used, then create one.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nemáte odkaz s pozvánkou. Zvolte, jak dlouho platí a kolikrát se dá použít, a pak ho vytvořte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no tienes un enlace de invitación. Elige cuánto dura y cuántas veces se puede usar, y créalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas encore de lien d’invitation. Choisissez sa durée et son nombre d’utilisations, puis créez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora un link d’invito. Scegli quanto dura e quante volte si può usare, poi crealo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não tem um link de convite. Escolha quanto tempo dura e quantas vezes pode ser usado, depois crie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас пока нет ссылки-приглашения. Выберите срок действия и число использований, затем создайте её."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有邀请链接。选择有效期和可使用次数，然后创建一个。"
          }
        }
      }
    },
    "You won't get push notifications": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebudete dostávat push oznámení"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No recibirás notificaciones push"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne recevrez pas de notifications push"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riceverai notifiche push"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não vai receber notificações push"
          }
        },
        "ru": {
