    "A pack is a set of images picked together, each named after its file. Square PNGs look best.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Balíček je sada obrázků vybraných najednou, každý pojmenovaný podle svého souboru. Nejlépe vypadají čtvercové PNG."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paquete es un conjunto de imágenes elegidas juntas, cada una con el nombre de su archivo. Los PNG cuadrados quedan mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pack est un ensemble d’images choisies ensemble, chacune nommée d’après son fichier. Les PNG carrés rendent le mieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pacchetto è un insieme di immagini scelte insieme, ognuna con il nome del suo file. I PNG quadrati rendono meglio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pacote é um conjunto de imagens escolhidas juntas, cada uma com o nome do seu arquivo. PNGs quadrados ficam melhores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор — это несколько изображений, выбранных вместе, каждое названо по имени файла. Лучше всего смотрятся квадратные PNG."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表情包是一组一起选择的图片，每张以其文件名命名。正方形 PNG 效果最佳。"
          }
        }
      }
    },
