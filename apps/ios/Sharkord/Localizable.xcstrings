    "No emoji yet. Add some, or a whole pack, from Manage.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné emoji. Přidejte nějaké, nebo celý balíček, v části Spravovat."
          }
        },
        "es": {
          "stringUnit": {
