    },
    "Everyone can see and use a public channel. Permissions only apply once it is private.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Veřejný kanál mohou vidět a používat všichni. Oprávnění platí, až když je soukromý."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos pueden ver y usar un canal público. Los permisos solo se aplican cuando es privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut voir et utiliser un salon public. Les permissions ne s’appliquent qu’une fois qu’il est privé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti possono vedere e usare un canale pubblico. I permessi valgono solo quando è privato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos podem ver e usar um canal público. As permissões só valem quando ele é privado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публичный канал могут видеть и использовать все. Права действуют, только когда он закрытый."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有人都可以查看和使用公开频道。频道设为私密后权限才生效。"
          }
        }
      }
    },
    "Everyone with this role loses it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všichni s touto rolí o ni přijdou."
