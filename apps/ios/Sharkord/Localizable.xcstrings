          }
        }
      }
    },
    "This plugin has nothing to configure.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento plugin nemá co nastavovat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin no tiene nada que configurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce plugin n’a rien à configurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo plugin non ha nulla da configurare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin não tem nada para configurar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого плагина нет настроек."
          }
        },
        "zh-Hans": {
