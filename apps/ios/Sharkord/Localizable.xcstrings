    "Voice Isolation is on. Apple's own suppression already cleans your mic, so Standard adds little.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izolace hlasu je zapnutá. Potlačení od Applu už váš mikrofon čistí, takže Standardní přidá málo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aislamiento de voz está activado. La supresión de Apple ya limpia tu micro, así que Estándar aporta poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isolation de la voix est activée. La réduction d’Apple nettoie déjà votre micro, Standard apporte donc peu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Isolamento voce è attivo. La soppressione di Apple pulisce già il microfono, quindi Standard aggiunge poco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Isolamento de voz está ativado. A supressão da Apple já limpa seu microfone, então Padrão acrescenta pouco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Изоляция голоса» включена. Подавление от Apple уже очищает микрофон, поэтому «Стандартное» мало что добавит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“语音突显”已打开。Apple 自带的降噪已在净化你的麦克风，因此“标准”作用不大。"
          }
        }
      }
    },
