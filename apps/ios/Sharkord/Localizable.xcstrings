    "When you are ready to talk, just hop in.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až budete chtít mluvit, prostě se připojte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando quieras hablar, entra sin más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous êtes prêt à parler, rejoignez simplement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sei pronto a parlare, entra e basta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando quiser falar, é só entrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда будете готовы говорить, просто заходите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好说话时，直接加入即可。"
          }
        }
      }
    },
    "Where people send questions and reports about this server or a message on it. The apps show it as the contact in About, and Report opens an email to it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kam lidé posílají dotazy a nahlášení k tomuto serveru nebo zprávě na něm. Aplikace to zobrazují jako kontakt v části O aplikaci a Nahlásit otevře e-mail na tuto adresu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde la gente envía preguntas e informes sobre este servidor o un mensaje en él. Las apps lo muestran como contacto en Acerca de, e Informar abre un correo dirigido a él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Là où les gens envoient questions et signalements sur ce serveur ou un de ses messages. Les apps l’affichent comme contact dans À propos, et Signaler ouvre un e-mail vers cette adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove le persone inviano domande e segnalazioni su questo server o su un suo messaggio. Le app lo mostrano come contatto in Informazioni, e Segnala apre un’email verso questo indirizzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde as pessoas enviam dúvidas e denúncias sobre este servidor ou uma mensagem nele. Os apps mostram como contato em Sobre, e Denunciar abre um e-mail para ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сюда люди присылают вопросы и жалобы на этот сервер или сообщение на нём. Приложения показывают его как контакт в разделе «О приложении», а «Пожаловаться» открывает письмо на этот адрес."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户发送关于此服务器或其中消息的问题和举报的地方。应用会在“关于”中将其显示为联系方式，“举报”会打开发往该地址的邮件。"
          }
        }
      }
    },
