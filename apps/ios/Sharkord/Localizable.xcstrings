    "New members get the default role when they join.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Noví členové dostanou při připojení výchozí roli."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos miembros reciben el rol predeterminado al unirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux membres reçoivent le rôle par défaut en rejoignant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi membri ricevono il ruolo predefinito quando entrano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos membros recebem o cargo padrão ao entrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые участники получают роль по умолчанию при входе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新成员加入时会获得默认身份组。"
          }
        }
      }
    },
    "New members land here, the only channel they can see, until they react.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Noví členové přistanou tady, v jediném kanálu, který vidí, dokud nezareagují."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos miembros llegan aquí, el único canal que pueden ver, hasta que reaccionen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux membres arrivent ici, le seul salon qu’ils voient, jusqu’à ce qu’ils réagissent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi membri arrivano qui, l’unico canale che vedono, finché non reagiscono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos membros chegam aqui, o único canal que veem, até reagirem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые участники попадают сюда, в единственный видимый им канал, пока не поставят реакцию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新成员会先来到这里，在作出回应之前，这是他们唯一能看到的频道。"
          }
        }
      }
    },
