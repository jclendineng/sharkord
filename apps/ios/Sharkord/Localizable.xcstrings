    "Your account is removed from this server and your messages stay as Deleted User. This can't be undone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš účet se z tohoto serveru odebere a vaše zprávy zůstanou jako od Smazaného uživatele. Tuto akci nelze vrátit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta se elimina de este servidor y tus mensajes quedan como Usuario eliminado. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est retiré de ce serveur et vos messages restent sous Utilisateur supprimé. Action irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account viene rimosso da questo server e i tuoi messaggi restano come Utente eliminato. Non si può annullare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta é removida deste servidor e suas mensagens ficam como Usuário excluído. Não dá para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аккаунт удаляется с этого сервера, а сообщения остаются от «Удалённого пользователя». Это нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户将从此服务器移除，你的消息会显示为“已删除用户”。此操作无法撤销。"
          }
        }
      }
    },
    "Your account, messages, reactions and uploads are removed from this server. This can't be undone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš účet, zprávy, reakce a nahrané soubory se z tohoto serveru odeberou. Tuto akci nelze vrátit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta, mensajes, reacciones y subidas se eliminan de este servidor. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte, vos messages, réactions et envois sont retirés de ce serveur. Action irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account, i messaggi, le reazioni e i caricamenti vengono rimossi da questo server. Non si può annullare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta, mensagens, reações e envios são removidos deste servidor. Não dá para desfazer."
          }
