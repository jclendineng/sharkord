    "1 use isn't listed: from before Sharkord kept who joined, or an account deleted since.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "1 použití není zobrazeno: je z doby, kdy Sharkord ještě neukládal, kdo se připojil, nebo jde o mezitím smazaný účet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 uso no aparece: es de antes de que Sharkord guardara quién se unió, o de una cuenta eliminada desde entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 utilisation n’est pas listée : antérieure au suivi des arrivées par Sharkord, ou compte supprimé depuis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 utilizzo non è elencato: precedente a quando Sharkord registrava chi entrava, o di un account eliminato nel frattempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 uso não aparece: é de antes de o Sharkord registrar quem entrou, ou de uma conta excluída desde então."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 использование не показано: оно было до того, как Sharkord начал запоминать, кто вошёл, или аккаунт с тех пор удалён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 1 次使用未列出：发生在 Sharkord 开始记录加入者之前，或相关账户已被删除。"
          }
        }
      }
    },
    "A device": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení"
          }
        },
        "es": {
