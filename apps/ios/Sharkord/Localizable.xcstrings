    "Contact goes to this server's admins. Report a Problem is for the app itself.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakt míří na administrátory tohoto serveru. Nahlásit problém je pro samotnou aplikaci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto llega a los administradores de este servidor. Informar de un problema es para la propia app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact s’adresse aux administrateurs de ce serveur. Signaler un problème concerne l’app elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contatto va agli amministratori di questo server. Segnala un problema riguarda l’app stessa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contato vai para os administradores deste servidor. Relatar um problema é sobre o próprio app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт ведёт к администраторам этого сервера. «Сообщить о проблеме» — для самого приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“联系方式”发送给本服务器的管理员。“报告问题”则针对应用本身。"
          }
        }
      }
    },
    "Controls how loud sounds are for you personally.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řídí hlasitost zvuků jen pro vás."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla lo alto que suenan los sonidos para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle le volume des sons pour vous seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola il volume dei suoni solo per te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla o volume dos sons só para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Громкость звуков только для вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅控制你自己听到的音效音量。"
          }
        }
      }
    },
    "Converts uploaded images to WebP. Higher quality keeps more detail and uses more space.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Převádí nahrané obrázky do WebP. Vyšší kvalita zachová víc detailů a zabere víc místa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte las imágenes subidas a WebP. Más calidad conserva más detalle y ocupa más espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertit les images envoyées en WebP. Une qualité plus élevée garde plus de détails et prend plus de place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Converte le immagini caricate in WebP. Una qualità più alta conserva più dettagli e occupa più spazio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converte imagens enviadas para WebP. Qualidade maior mantém mais detalhes e ocupa mais espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преобразует загруженные изображения в WebP. Более высокое качество сохраняет больше деталей и занимает больше места."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将上传的图片转换为 WebP。质量越高，细节保留越多，占用空间也越多。"
          }
        }
      }
    },
