    "Kicking disconnects them, they can join again. A ban keeps them out until unbanned.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhození odpojí, ale člověk se může vrátit. Ban ho drží venku, dokud se nezruší."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Echar desconecta a la persona, puede volver a unirse. Una expulsión la mantiene fuera hasta que se levante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expulser déconnecte la personne, elle peut revenir. Un bannissement l’empêche de revenir tant qu’il n’est pas levé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Espellere disconnette la persona, può rientrare. Un ban la tiene fuori finché non viene rimosso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expulsar desconecta a pessoa, ela pode voltar. Um banimento a mantém fora até ser removido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выгнанный отключается, но может вернуться. Блокировка не пускает, пока её не снимут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "踢出会断开对方的连接，对方可以重新加入。封禁则会阻止其加入，直到解除封禁。"
          }
        }
      }
    },
