          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è l’inizio del canale #%@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o começo do canal #%@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это начало канала #%@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
