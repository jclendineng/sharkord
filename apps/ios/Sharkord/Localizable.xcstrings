    "Click an invite to see who joined with it, right click to delete it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na pozvánku a uvidíte, kdo se s ní připojil, pravým kliknutím ji smažete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en una invitación para ver quién se unió con ella, clic derecho para eliminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur une invitation pour voir qui l’a utilisée, clic droit pour la supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un invito per vedere chi è entrato con esso, clic destro per eliminarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um convite para ver quem entrou com ele, clique com o botão direito para excluí-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на приглашение, чтобы увидеть, кто по нему вошёл, правый клик — удалить."
