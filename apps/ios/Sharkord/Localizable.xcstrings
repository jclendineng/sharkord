        }
      }
    },
    "This link is taking you to the following website": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento odkaz vás vede na následující web"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace te lleva al siguiente sitio web"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien vous emmène vers le site suivant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo link ti porta al seguente sito web"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link leva você ao seguinte site"
          }
        },
