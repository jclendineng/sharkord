            "state": "translated",
            "value": "Non sembra l’indirizzo di un server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não parece um endereço de servidor."
          }
        },
        "ru": {
