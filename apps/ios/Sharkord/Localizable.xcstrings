          }
        }
      }
    },
    "A link they open to set a new password. It works once, for 24 hours, and signs them out everywhere.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkaz, kterým si nastaví nové heslo. Funguje jednou, po dobu 24 hodin, a odhlásí je všude."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace que abren para crear una contraseña nueva. Funciona una vez, durante 24 horas, y cierra su sesión en todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien qu’ils ouvrent pour choisir un nouveau mot de passe. Il fonctionne une fois, pendant 24 heures, et les déconnecte partout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un link che aprono per impostare una nuova password. Funziona una volta, per 24 ore, e li disconnette ovunque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link que a pessoa abre para criar uma nova senha. Funciona uma vez, por 24 horas, e encerra a sessão dela em todos os lugares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка, по которой человек задаёт новый пароль. Работает один раз в течение 24 часов и завершает его сеансы везде."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方打开后可设置新密码的链接。只能使用一次，24 小时内有效，并会让对方在所有设备上退出登录。"
          }
        }
      }
    },
    "A member shows as their highest role with a color, and the member list groups them under it. The default role is given to everyone who joins.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Člen se zobrazuje se svou nejvyšší rolí, která má barvu, a seznam členů ho pod ní seskupí. Výchozí roli dostane každý, kdo se připojí."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un miembro aparece con su rol más alto que tenga color, y la lista de miembros lo agrupa bajo ese rol. El rol predeterminado se da a todos los que se unen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un membre apparaît avec son rôle le plus élevé qui a une couleur, et la liste des membres le range sous ce rôle. Le rôle par défaut est donné à tous ceux qui rejoignent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un membro appare con il suo ruolo più alto che ha un colore, e l’elenco dei membri lo raggruppa sotto quel ruolo. Il ruolo predefinito viene dato a chiunque entri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um membro aparece com seu cargo mais alto que tenha cor, e a lista de membros o agrupa sob esse cargo. O cargo padrão é dado a todos que entram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Участник показывается со своей высшей ролью, у которой есть цвет, и в списке участников группируется под ней. Роль по умолчанию получают все, кто входит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员显示为其带颜色的最高身份组，成员列表也会按该身份组分组。默认身份组会分配给每位加入的人。"
          }
        }
      }
    },
    "A member's own settings win over their roles.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní nastavení člena má přednost před jeho rolemi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes propios de un miembro prevalecen sobre sus roles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages propres à un membre l’emportent sur ses rôles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni proprie di un membro prevalgono sui suoi ruoli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações próprias de um membro prevalecem sobre seus cargos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственные настройки участника важнее его ролей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员自己的设置优先于其身份组。"
          }
        }
      }
    },
    "A new code in %lld:%@": {
      "localizations": {
        "cs": {
