      }
    },
    "Showing the most recent matches. Try a more specific search.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazují se nejnovější výsledky. Zkuste konkrétnější hledání."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran las coincidencias más recientes. Prueba una búsqueda más concreta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats les plus récents sont affichés. Essayez une recherche plus précise."
          }
        },
