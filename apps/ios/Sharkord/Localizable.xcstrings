        }
      }
    },
    "This plugin doesn't offer anything people use directly.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento plugin nenabízí nic, co lidé používají přímo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin no ofrece nada que la gente use directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce plugin ne propose rien que les gens utilisent directement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo plugin non offre nulla che le persone usino direttamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin não oferece nada que as pessoas usem diretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот плагин не предлагает ничего, чем пользуются напрямую."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
