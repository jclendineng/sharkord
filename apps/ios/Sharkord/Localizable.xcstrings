        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld plus récents sur %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ultimi %lld di %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os %lld mais recentes de %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние %lld из %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %2$lld 个中最新的 %1$lld 个。"
          }
        }
      }
    },
    "The new passwords do not match.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nová hesla se neshodují."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas nuevas no coinciden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux mots de passe ne correspondent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove password non corrispondono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As novas senhas não coincidem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые пароли не совпадают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两次输入的新密码不一致。"
          }
        }
      }
    },
    "The quota isn't a hard limit: an upload is written first and the rule applies after, so keep more disk free than the quota. 0 per member means unlimited, a role can override it in Roles.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvóta není pevný limit: nahraný soubor se nejdřív zapíše a pravidlo platí až potom, proto nechte na disku víc volného místa než je kvóta. 0 na člena znamená bez omezení, role to může změnit v části Role."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuota no es un límite estricto: una subida se escribe primero y la regla se aplica después, así que deja más disco libre que la cuota. 0 por miembro significa ilimitado, un rol puede cambiarlo en Roles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota n’est pas une limite stricte : un envoi est d’abord écrit et la règle s’applique ensuite, gardez donc plus d’espace libre que le quota. 0 par membre signifie illimité, un rôle peut le modifier dans Rôles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La quota non è un limite rigido: un caricamento viene scritto prima e la regola si applica dopo, quindi tieni più spazio libero della quota. 0 per membro significa illimitato, un ruolo può cambiarlo in Ruoli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota não é um limite rígido: um envio é gravado primeiro e a regra vale depois, então mantenha mais disco livre do que a cota. 0 por membro significa ilimitado, um cargo pode mudar isso em Cargos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Квота — не жёсткий предел: загрузка сначала записывается, а правило применяется потом, поэтому держите на диске больше свободного места, чем квота. 0 на участника — без ограничений, роль может изменить это в разделе «Роли»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配额不是硬性限制：上传会先写入，之后才应用规则，因此请保留比配额更多的磁盘可用空间。每位成员 0 表示无限制，身份组可以在“身份组”中覆盖。"
          }
        }
      }
    },
    "The server owner can always use it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastník serveru ho může používat vždy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El propietario del servidor siempre puede usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le propriétaire du serveur peut toujours l’utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il proprietario del server può sempre usarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dono do servidor sempre pode usar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Владелец сервера может пользоваться всегда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器所有者始终可以使用。"
          }
        }
      }
    },
    "There are no threads": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná vlákna"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay hilos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono thread"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há conversas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веток нет"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有子区"
          }
        }
      }
    },
    "These are the devices signed in to your account on %@. Sign out of any you don't recognize, and change your password if you think someone else has it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto jsou zařízení přihlášená k vašemu účtu na %@. Odhlaste ta, která nepoznáváte, a změňte heslo, pokud si myslíte, že ho zná někdo jiný."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos son los dispositivos con sesión iniciada en tu cuenta de %@. Cierra la sesión de los que no reconozcas y cambia tu contraseña si crees que alguien la tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici les appareils connectés à votre compte sur %@. Déconnectez ceux que vous ne reconnaissez pas, et changez votre mot de passe si vous pensez que quelqu’un le connaît."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi sono i dispositivi che hanno accesso al tuo account su %@. Esci da quelli che non riconosci e cambia la password se pensi che qualcun altro la conosca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes são os dispositivos conectados à sua conta em %@. Saia dos que você não reconhecer e mude sua senha se achar que outra pessoa a tem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройства, на которых выполнен вход в ваш аккаунт на %@. Выйдите на тех, которые не узнаёте, и смените пароль, если думаете, что он известен кому-то ещё."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是在 %@ 上登录了你账户的设备。退出你不认识的设备，如果你认为有人知道你的密码，请更改密码。"
          }
        }
      }
    },
    "These let the role change the server itself. Give them out carefully.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato oprávnění umožňují roli měnit samotný server. Přidělujte je opatrně."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos permiten al rol cambiar el propio servidor. Dalos con cuidado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles-ci permettent au rôle de modifier le serveur lui-même. Accordez-les avec prudence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi permettono al ruolo di modificare il server stesso. Dalli con attenzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas deixam o cargo mudar o próprio servidor. Dê com cuidado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти права позволяют роли менять сам сервер. Выдавайте их осторожно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些权限允许该身份组更改服务器本身。请谨慎授予。"
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto akci nelze vrátit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Action irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não dá para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。"
          }
        }
      }
    },
    "This channel is public, so everyone can see and use it and nothing below applies. Make it private for these to take effect.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kanál je veřejný, takže ho všichni vidí a používají a nic níže neplatí. Nastavte ho jako soukromý, aby se oprávnění projevila."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este canal es público, así que todos pueden verlo y usarlo y nada de lo de abajo se aplica. Hazlo privado para que surtan efecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce salon est public, tout le monde peut donc le voir et l’utiliser et rien ci-dessous ne s’applique. Rendez-le privé pour que cela prenne effet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo canale è pubblico, quindi tutti possono vederlo e usarlo e niente di ciò che segue si applica. Rendilo privato perché abbiano effetto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este canal é público, então todos podem vê-lo e usá-lo e nada abaixo vale. Torne-o privado para que isso tenha efeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот канал публичный, поэтому его видят и используют все, и ничего ниже не действует. Сделайте его закрытым, чтобы права заработали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此频道是公开的，所有人都能查看和使用，下方设置均不生效。将其设为私密后才会生效。"
          }
        }
      }
    },
    "This invite was deleted and no longer works. It is kept so you can see who joined with it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato pozvánka byla smazána a už nefunguje. Zůstává, abyste viděli, kdo se s ní připojil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta invitación se eliminó y ya no funciona. Se conserva para que veas quién se unió con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette invitation a été supprimée et ne fonctionne plus. Elle est conservée pour voir qui l’a utilisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo invito è stato eliminato e non funziona più. Viene conservato per vedere chi è entrato con esso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este convite foi excluído e não funciona mais. Ele é mantido para você ver quem entrou com ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приглашение удалено и больше не работает. Оно сохранено, чтобы было видно, кто по нему вошёл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此邀请已删除，不再有效。保留它是为了让你查看通过它加入的人。"
          }
        }
      }
    },
    "This is the beginning of your direct message history with %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je začátek vaší historie soukromých zpráv s %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el comienzo de tu historial de mensajes directos con %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le début de votre historique de messages privés avec %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è l’inizio della tua cronologia di messaggi diretti con %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
