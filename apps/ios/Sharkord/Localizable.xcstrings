    "Direct messages, mentions and replies to you. A server only offers this when its owner has set it up.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soukromé zprávy, zmínky a odpovědi vám. Server to nabízí jen tehdy, když to jeho vlastník nastavil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes directos, menciones y respuestas a ti. Un servidor solo lo ofrece si su propietario lo ha configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages privés, mentions et réponses qui vous sont adressés. Un serveur ne le propose que si son propriétaire l’a configuré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaggi diretti, menzioni e risposte a te. Un server lo offre solo se il proprietario l’ha configurato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagens diretas, menções e respostas a você. Um servidor só oferece isso se o dono tiver configurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личные сообщения, упоминания и ответы вам. Сервер предлагает это, только если владелец всё настроил."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私信、提及以及对你的回复。仅当服务器所有者已设置时才提供。"
          }
        }
      }
    },
