    "Changing your password logs you out on every device, this one included.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna hesla vás odhlásí na všech zařízeních včetně tohoto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la contraseña cierra tu sesión en todos los dispositivos, incluido este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer votre mot de passe vous déconnecte sur tous vos appareils, y compris celui-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare la password ti disconnette da tutti i dispositivi, compreso questo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar a senha encerra sua sessão em todos os dispositivos, incluindo este."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена пароля завершает сеансы на всех устройствах, включая это."
