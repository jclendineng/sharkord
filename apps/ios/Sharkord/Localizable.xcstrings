    "Sharkord can't see your photos. Allow access in %@, or pick one with Photos below.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharkord nevidí vaše fotky. Povolte přístup v %@, nebo některou vyberte přes Fotky níže."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharkord no puede ver tus fotos. Permite el acceso en %@ o elige una con Fotos abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharkord ne peut pas voir vos photos. Autorisez l’accès dans %@, ou choisissez-en une avec Photos ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharkord non può vedere le tue foto. Consenti l’accesso in %@, oppure scegline una con Foto qui sotto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sharkord não consegue ver suas fotos. Permita o acesso em %@ ou escolha uma com Fotos abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharkord не видит ваши фото. Разрешите доступ в %@ или выберите фото через «Фото» ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharkord 无法查看你的照片。请在 %@ 中允许访问，或使用下方的“照片”选择一张。"
          }
        }
      }
    },
