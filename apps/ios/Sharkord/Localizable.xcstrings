    "Long press a message and choose Pin Message to keep it here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte zprávu a zvolte Připnout zprávu, aby zůstala tady."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un mensaje y elige Fijar mensaje para guardarlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur un message et choisissez Épingler le message pour le garder ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un messaggio e scegli Fissa messaggio per tenerlo qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure uma mensagem e escolha Fixar mensagem para mantê-la aqui."
          }
        },
        "ru": {
