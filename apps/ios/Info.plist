<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Sharkord uses the camera so you can share video in voice channels.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sharkord connects to servers on your local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sharkord uses the microphone so you can talk in voice channels.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Sharkord shows your recent photos and videos so you can attach them to a message.</string>
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>SharkordKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.sharkord.shared</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
