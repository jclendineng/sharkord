<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sharkord.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sharkord</string>
			</array>
		</dict>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Sharkord uses the camera so you can share video in voice channels.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sharkord connects to servers on your local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sharkord uses the microphone so you can talk in voice channels.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Sharkord saves pictures you choose to save into your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Sharkord shows your recent photos and videos so you can attach them to a message.</string>
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>screen-capture</string>
	</array>
</dict>
</plist>
